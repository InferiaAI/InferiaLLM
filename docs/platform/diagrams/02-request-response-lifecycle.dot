digraph request_response_lifecycle {
  graph [rankdir=LR, bgcolor="white", pad="0.22", nodesep="0.35", ranksep="0.65", fontname="Arial"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, margin="0.12,0.07", color="#294861", fillcolor="#EDF5FA"];
  edge [fontname="Arial", fontsize=9, color="#516B7A", arrowsize=0.7];

  client [label="Client", fillcolor="#FFF3D7", color="#A76600"];
  app [label="Unified app\n/inf/v1/...", fillcolor="#DFF3E4", color="#286A45"];
  edge_api [label="Inference edge\nauth context cache\nquota/rate/concurrency checks", fillcolor="#DCEBFA", color="#2D5B8D"];
  admission [label="Policy / admission\nclass → admit, queue, shed", fillcolor="#DCEBFA", color="#2D5B8D"];
  route [label="Deployment endpoint\nllm-d router or engine", fillcolor="#F4E6FB", color="#75428A"];
  engine [label="Engine\ncontinuous batching\npaged KV / prefix cache", fillcolor="#F4E6FB", color="#75428A"];
  usage [label="Async usage pipeline\nTODO WS2", style="rounded,dashed,filled", fillcolor="#FFF9E7", color="#A76600"];

  client -> app [label="HTTPS request"];
  app -> edge_api [label="mounted /inf route"];
  edge_api -> admission [label="resolved identity + estimate"];
  admission -> route [label="accepted request\nclass/fairness objective"];
  route -> engine [label="selected endpoint"];
  engine -> edge_api [label="HTTP/SSE tokens"];
  edge_api -> client [label="streamed response"];
  edge_api -> usage [label="emit after request", style=dashed];
  client -> edge_api [label="disconnect → abort upstream\nTODO WS2", style=dashed, constraint=false];
}
