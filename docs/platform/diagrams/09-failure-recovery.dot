digraph G { rankdir=LR; node [shape=box style=rounded]; fail[label="Pod / node / zone failure"]; detect[label="Health checks\n+ outlier detection"]; retry[label="Retry only before\nfirst token"]; reschedule[label="Reschedule / recover"]; failafter[label="After first token:\nfail, never duplicate"]; fail->detect; detect->retry; retry->reschedule; detect->failafter; label="Failure recovery and high availability (target; retry invariant implemented in simulator)"; }
